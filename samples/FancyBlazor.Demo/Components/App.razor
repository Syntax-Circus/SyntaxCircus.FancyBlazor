<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/png" sizes="64x64" href="@Assets["images/brand/fancyblazor-favicon-64.png"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["FancyBlazor.Demo.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveAuto" />
</head>
<body>
    <Routes @rendermode="InteractiveAuto" />
    <div id="components-reconnect-modal" role="status" aria-live="assertive" aria-atomic="true">
        <div class="reconnect-panel">
            <p class="specimen-label">CONNECTION INTERRUPTED</p>
            <p class="reconnect-panel__message">Rejoining the server…</p>
        </div>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
