    <section class="webgl-presets" aria-labelledby="webgl-presets-heading">
        <div class="webgl-presets__intro">
            <p class="specimen-label">CALIBRATED STARTING POINTS</p>
            <h2 id="webgl-presets-heading">Change the material, not the markup.</h2>
            <p>Each preset retunes the live specimen above. It does not create another canvas or replace the article.</p>
        </div>
        <div class="webgl-preset-list">
            <button type="button" @onclick="ApplyThinFilm">
                <span>01 / WITCHLIGHT</span><strong>Thin film</strong><small>Bright interference color with a light surface profile.</small>
            </button>
            <button type="button" data-testid="webgl-preset-deep-field" @onclick="ApplyDeepField">
                <span>02 / VIRIDIAN</span><strong>Deep field</strong><small>Slower motion, heavier depth, and a submerged green spectrum.</small>
            </button>
            <button type="button" @onclick="ApplyStillFoil">
                <span>03 / GLACIER</span><strong>Still foil</strong><small>A motionless silver-blue treatment for quieter reading planes.</small>
            </button>
        </div>
    </section>

    <section class="surface-recipe" aria-labelledby="webgl-recipe-heading">
        <div class="surface-recipe__copy">
            <p class="specimen-label">PREVIEW COMPANION / TYPED CONTROLS</p>
            <h2 id="webgl-recipe-heading">Install without changing your content.</h2>
            <p>Add the optional <code>SyntaxCircus.FancyBlazor.WebGL</code> package and call <code>AddFancyBlazorWebGl()</code> in each executable host. The preview wraps semantic markup without npm, a CDN, script tags, or raw shader uniforms.</p>
            <p>The renderer uses a packaged, official Three.js r184 build. Its visual direction was informed by the ThreeUI effect catalog; no ThreeUI source code or assets are included.</p>
        </div>
        <pre class="surface-recipe__code"><code>&lt;HolographicSurface Palette="FancyPalettes.Witchlight"
                      Intensity="0.68"
                      Depth="0.42"
                      Sheen="0.74"
                      Speed="0.85"
                      Interactive&gt;
    &lt;article&gt;Semantic content&lt;/article&gt;
&lt;/HolographicSurface&gt;</code></pre>
        <pre class="surface-recipe__code"><code>&lt;WaveFieldBackground Palette="FancyPalettes.Witchlight"
                      Intensity="0.6"
                      Amplitude="0.55"
                      Frequency="0.45"
                      Foam="0.6"
                      Speed="0.9"
                      Interactive&gt;
    &lt;article&gt;Semantic content&lt;/article&gt;
&lt;/WaveFieldBackground&gt;</code></pre>
        <pre class="surface-recipe__code"><code>&lt;RefractiveOrbBackground Palette="FancyPalettes.Witchlight"
                          Intensity="0.6"
                          Radius="0.55"
                          Distortion="0.5"
                          Sheen="0.65"
                          Speed="0.8"
                          Interactive&gt;
    &lt;article&gt;Semantic content&lt;/article&gt;
&lt;/RefractiveOrbBackground&gt;</code></pre>
        <pre class="surface-recipe__code"><code>&lt;PrismFieldBackground Palette="FancyPalettes.Witchlight"
                       Intensity="0.6"
                       Facets="0.5"
                       Dispersion="0.5"
                       Sheen="0.6"
                       Speed="0.7"
                       Interactive&gt;
    &lt;article&gt;Semantic content&lt;/article&gt;
&lt;/PrismFieldBackground&gt;</code></pre>
        <pre class="surface-recipe__code"><code>&lt;ParticleFieldBackground Palette="FancyPalettes.Witchlight"
                          Intensity="0.6"
                          Density="0.5"
                          Size="0.5"
                          Drift="0.5"
                          Speed="0.9"
                          Interactive&gt;
    &lt;article&gt;Semantic content&lt;/article&gt;
&lt;/ParticleFieldBackground&gt;</code></pre>
    </section>
</section>

@code {
    private static readonly PaletteChoice[] PaletteChoices =
    [
        new("Witchlight", FancyPalettes.Witchlight),
        new("Viridian", FancyPalettes.Viridian),
        new("Ember", FancyPalettes.Ember),
        new("Glacier", FancyPalettes.Glacier),
    ];

    private FancyPalette _palette = FancyPalettes.Witchlight;
    private double _intensity = 0.68;
    private double _depth = 0.42;
    private double _sheen = 0.74;
    private double _speed = 0.85;
    private bool _interactive = true;
    private bool _disabled;
    private FancyQuality _quality = FancyQuality.Auto;

    private FancyPalette _waveFieldPalette = FancyPalettes.Witchlight;
    private double _waveFieldIntensity = 0.6;
    private double _waveFieldAmplitude = 0.55;
    private double _waveFieldFrequency = 0.45;
    private double _waveFieldFoam = 0.6;
    private double _waveFieldSpeed = 0.9;
    private bool _waveFieldInteractive = true;
    private bool _waveFieldDisabled;
    private FancyQuality _waveFieldQuality = FancyQuality.Auto;

    private FancyPalette _refractiveOrbPalette = FancyPalettes.Witchlight;
    private double _refractiveOrbIntensity = 0.6;
    private double _refractiveOrbRadius = 0.55;
    private double _refractiveOrbDistortion = 0.5;
    private double _refractiveOrbSheen = 0.65;
    private double _refractiveOrbSpeed = 0.8;
    private bool _refractiveOrbInteractive = true;
    private bool _refractiveOrbDisabled;
    private FancyQuality _refractiveOrbQuality = FancyQuality.Auto;

    private FancyPalette _prismFieldPalette = FancyPalettes.Witchlight;
    private double _prismFieldIntensity = 0.6;
    private double _prismFieldFacets = 0.5;
    private double _prismFieldDispersion = 0.5;
    private double _prismFieldSheen = 0.6;
    private double _prismFieldSpeed = 0.7;
    private bool _prismFieldInteractive = true;
    private bool _prismFieldDisabled;
    private FancyQuality _prismFieldQuality = FancyQuality.Auto;

    private FancyPalette _particleFieldPalette = FancyPalettes.Witchlight;
    private double _particleFieldIntensity = 0.6;
    private double _particleFieldDensity = 0.5;
    private double _particleFieldSize = 0.5;
    private double _particleFieldDrift = 0.5;
    private double _particleFieldSpeed = 0.9;
    private bool _particleFieldInteractive = true;
    private bool _particleFieldDisabled;
    private FancyQuality _particleFieldQuality = FancyQuality.Auto;

    private static string Format(double value) => value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    private void ApplyThinFilm()
    {
        _palette = FancyPalettes.Witchlight;
        _intensity = 0.68;
