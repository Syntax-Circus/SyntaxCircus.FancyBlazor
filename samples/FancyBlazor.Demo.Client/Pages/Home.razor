@page "/"

<PageTitle>FancyBlazor · Visual effects for Blazor</PageTitle>

<ShaderBackground CssClass="demo-hero" data-testid="shader-background">
    <div class="hero-grid">
        <div class="hero-copy">
            <p class="kicker">OPTICAL COMPONENTS / .NET 10</p>
            <Reveal Effect="RevealEffect.BlurUp">
                <h1>Make the ordinary interface catch light.</h1>
            </Reveal>
            <Reveal Delay="@TimeSpan.FromMilliseconds(120)">
                <p class="lede">Shaders, borders, reveals, and motion composed in Razor. No framework islands. No runtime CDN.</p>
            </Reveal>
            <div class="hero-actions">
                <GlowBorder Color="#a7f3d0" Radius="999">
                    <a class="primary-action" href="/background">Inspect the effects</a>
                </GlowBorder>
                <code>dotnet add package SyntaxCircus.FancyBlazor</code>
            </div>
        </div>
        <Tilt Glare="true" Scale="1.025" CssClass="specimen-tilt">
            <article class="specimen-card">
                <picture>
                    <source srcset="/images/brand/fancyblazor-marketing-640.webp" type="image/webp" />
                    <img class="specimen-card__brand" src="/images/brand/fancyblazor-marketing-640.png" width="640" height="640" alt="FancyBlazor optical mark" />
                </picture>
                <p class="specimen-label">LIVE SPECIMEN / NACRE</p>
                <strong>Semantic content remains selectable, readable, and yours.</strong>
                <span>Pointer motion is decorative; keyboard behavior is untouched.</span>
            </article>
        </Tilt>
    </div>
</ShaderBackground>

<section class="demo-page effect-index">
    <p class="kicker">COMPOSABLE EFFECTS / ONE API</p>
    <h2>Start with the feeling you want to create.</h2>
    <div class="effect-grid">
        <a href="/background"><span>BACKGROUND</span><strong>Atmosphere</strong><small>Shaders, gradients, aurora, and orbital light</small></a>
        <a href="/spatial-surfaces"><span>SURFACES</span><strong>Depth</strong><small>Glow, glass, beams, grids, and texture</small></a>
        <a href="/narrative-motion"><span>MOTION</span><strong>Rhythm</strong><small>Viewport, staggered, scroll, and parallax movement</small></a>
        <a href="/expressive-effects"><span>TYPOGRAPHY</span><strong>Voice</strong><small>Gradient, stroke, highlight, and semantic text entrances</small></a>
        <a href="/interaction-feedback"><span>INTERACTION</span><strong>Response</strong><small>Pointer motion, press, focus, ripple, and cursor feedback</small></a>
        <a href="/composition-authoring"><span>COMPOSITION</span><strong>Layers</strong><small>Named presets for heroes, reading planes, actions, and panels</small></a>
    </div>
</section>

