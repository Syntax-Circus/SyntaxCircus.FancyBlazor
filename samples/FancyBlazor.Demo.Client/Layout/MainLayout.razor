@inherits LayoutComponentBase

<div class="site-shell" @onclick="CloseMenu">
<header class="site-header">
    <a class="wordmark" href="/"><img class="wordmark__icon" src="/images/brand/fancyblazor-favicon-64.png" alt="" aria-hidden="true" />FancyBlazor</a>
    <details class="site-menu" open="@_isMenuOpen" @onclick:stopPropagation="true">
        <summary aria-expanded="@_isMenuOpen" @onclick="ToggleMenu" @onclick:preventDefault="true"><span class="menu-label--desktop">Explore effects</span><span class="menu-label--mobile">Menu</span><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></summary>
        <nav aria-label="Examples">
            <div class="menu-group">
                <span class="menu-group__label">Surfaces</span>
                <NavLink href="/background" @onclick="CloseMenu">Background</NavLink>
                <NavLink href="/border" @onclick="CloseMenu">Border</NavLink>
                <NavLink href="/spatial-surfaces" @onclick="CloseMenu">Spatial surfaces</NavLink>
            </div>
            <div class="menu-group">
                <span class="menu-group__label">Motion</span>
                <NavLink href="/reveal" @onclick="CloseMenu">Reveal</NavLink>
                <NavLink href="/tilt" @onclick="CloseMenu">Tilt</NavLink>
                <NavLink href="/narrative-motion" @onclick="CloseMenu">Narrative motion</NavLink>
            </div>
            <div class="menu-group">
                <span class="menu-group__label">More to explore</span>
                <NavLink href="/expanded-effects" @onclick="CloseMenu">More effects</NavLink>
                <NavLink href="/expressive-effects" @onclick="CloseMenu">Expressive effects</NavLink>
                <NavLink href="/interaction-feedback" @onclick="CloseMenu">Interaction feedback</NavLink>
                <NavLink href="/css-first-catalog" @onclick="CloseMenu">CSS-first catalog</NavLink>
                <NavLink href="/composition-authoring" @onclick="CloseMenu">Composition and authoring</NavLink>
            </div>
            <a class="menu-github" href="https://github.com/Syntax-Circus/SyntaxCircus.FancyBlazor" target="_blank" rel="noreferrer" @onclick="CloseMenu">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
    </details>
    <a class="repository-link" href="https://github.com/Syntax-Circus/SyntaxCircus.FancyBlazor" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
</header>
<main>@Body</main>
<footer>
    <div class="footer-sitemap">
        <div class="footer-identity">
            <a class="wordmark" href="/">FancyBlazor</a>
            <p>Composable visual effects for Blazor, with ordinary semantic HTML at the center.</p>
        </div>
        <nav class="footer-nav" aria-label="Site map">
            <div class="footer-nav__group">
                <span class="menu-group__label">Surfaces</span>
                <NavLink href="/background">Background</NavLink>
                <NavLink href="/border">Border</NavLink>
                <NavLink href="/spatial-surfaces">Spatial surfaces</NavLink>
            </div>
            <div class="footer-nav__group">
                <span class="menu-group__label">Motion</span>
                <NavLink href="/reveal">Reveal</NavLink>
                <NavLink href="/tilt">Tilt</NavLink>
                <NavLink href="/narrative-motion">Narrative motion</NavLink>
            </div>
            <div class="footer-nav__group">
                <span class="menu-group__label">More to explore</span>
                <NavLink href="/expanded-effects">More effects</NavLink>
                <NavLink href="/expressive-effects">Expressive effects</NavLink>
                <NavLink href="/interaction-feedback">Interaction feedback</NavLink>
                <NavLink href="/css-first-catalog">CSS-first catalog</NavLink>
                <NavLink href="/composition-authoring">Composition and authoring</NavLink>
            </div>
        </nav>
    </div>
    <div class="footer-meta">
        <span>FancyBlazor by <a href="https://www.syntaxcircus.com" target="_blank" rel="noreferrer">Syntax Circus</a></span>
        <span class="footer-links"><a href="https://github.com/Syntax-Circus/SyntaxCircus.FancyBlazor" target="_blank" rel="noreferrer">Source</a><a href="https://github.com/Syntax-Circus/SyntaxCircus.FancyBlazor/issues" target="_blank" rel="noreferrer">Report an issue</a><span>MIT · .NET 10</span></span>
    </div>
</footer>
</div>

@code {
    private bool _isMenuOpen;

    private void ToggleMenu() => _isMenuOpen = !_isMenuOpen;

    private void CloseMenu() => _isMenuOpen = false;
}
