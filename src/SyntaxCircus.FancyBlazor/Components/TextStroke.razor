@namespace SyntaxCircus.FancyBlazor

<div @attributes="RootAttributes">@ChildContent</div>

@code {
    [Parameter] public string Color { get; set; } = "currentColor";
    [Parameter] public string Fill { get; set; } = "currentColor";
    [Parameter] public double Width { get; set; } = 1;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private IReadOnlyDictionary<string, object> RootAttributes => AttributeComposer.Compose("syntax-circus-fancy-text-stroke", CssClass,
        $"--sc-fancy-text-stroke-color:{Color};--sc-fancy-text-stroke-fill:{Fill};--sc-fancy-text-stroke-width:{AttributeComposer.Number(AttributeComposer.Clamp(Width, 0, 8))}px", Style, AdditionalAttributes,
        new Dictionary<string, object> { ["data-fancy-effect"] = "text-stroke", ["data-fancy-disabled"] = Disabled ? "true" : "false" });
}
