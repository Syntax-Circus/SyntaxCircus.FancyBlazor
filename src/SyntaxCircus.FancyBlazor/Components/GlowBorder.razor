@namespace SyntaxCircus.FancyBlazor

<div @attributes="RootAttributes">
    <div class="syntax-circus-fancy-glow-border__content">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>Gets or sets the CSS color used by the glow.</summary>
    [Parameter]
    public string Color { get; set; } = "currentColor";

    /// <summary>Gets or sets glow intensity from zero through one.</summary>
    [Parameter]
    public double Intensity { get; set; } = 0.5;

    /// <summary>Gets or sets the corner radius in CSS pixels.</summary>
    [Parameter]
    public double Radius { get; set; } = 12;

    /// <summary>Gets or sets one animation cycle duration.</summary>
    [Parameter]
    public TimeSpan Duration { get; set; } = TimeSpan.FromSeconds(3);

    /// <summary>Gets or sets whether the glow rotates.</summary>
    [Parameter]
    public bool Animated { get; set; } = true;

    /// <summary>Gets or sets whether the visual effect is disabled.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Gets or sets an additional class for the outer wrapper.</summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>Gets or sets additional inline styles for the outer wrapper.</summary>
    [Parameter]
    public string? Style { get; set; }

    /// <summary>Gets or sets content rendered inside the border.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets unmatched attributes applied to the outer wrapper.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private IReadOnlyDictionary<string, object> RootAttributes => AttributeComposer.Compose(
        "syntax-circus-fancy-glow-border",
        CssClass,
        BuildStyle(),
        Style,
        AdditionalAttributes,
        new Dictionary<string, object>
        {
            ["data-fancy-effect"] = "glow-border",
            ["data-fancy-animated"] = Animated && !Disabled ? "true" : "false",
            ["data-fancy-disabled"] = Disabled ? "true" : "false",
        });

    private string BuildStyle()
    {
        var intensity = AttributeComposer.Clamp(Intensity, 0, 1);
        var radius = AttributeComposer.Clamp(Radius, 0, 999);
        var duration = AttributeComposer.NonNegative(Duration).TotalMilliseconds;
        return $"--sc-fancy-glow-color:{Color};--sc-fancy-glow-intensity:{AttributeComposer.Number(intensity)};--sc-fancy-radius:{AttributeComposer.Number(radius)}px;--sc-fancy-duration:{AttributeComposer.Number(duration)}ms";
    }
}
