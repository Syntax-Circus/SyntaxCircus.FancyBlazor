@namespace SyntaxCircus.FancyBlazor
<div @attributes="RootAttributes"><div class="syntax-circus-fancy-launch-halo__content">@ChildContent<span class="syntax-circus-fancy-launch-halo__layer" aria-hidden="true"></span></div></div>

@code {
    [Parameter] public string Color { get; set; } = "currentColor";
    [Parameter] public double Intensity { get; set; } = .5;
    [Parameter] public double Spread { get; set; } = 18;
    [Parameter] public bool Animated { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private IReadOnlyDictionary<string, object> RootAttributes => AttributeComposer.Compose("syntax-circus-fancy-launch-halo", CssClass,
        $"--sc-fancy-launch-halo-color:{Color};--sc-fancy-launch-halo-intensity:{AttributeComposer.Number(AttributeComposer.Clamp(Intensity, 0, 1))};--sc-fancy-launch-halo-spread:{AttributeComposer.Number(AttributeComposer.Clamp(Spread, 0, 64))}px", Style, AdditionalAttributes,
        new Dictionary<string, object> { ["data-fancy-effect"] = "launch-halo", ["data-fancy-animated"] = Animated && !Disabled ? "true" : "false", ["data-fancy-disabled"] = Disabled ? "true" : "false" });
}
