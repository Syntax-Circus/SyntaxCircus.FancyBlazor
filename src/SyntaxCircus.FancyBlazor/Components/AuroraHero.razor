@namespace SyntaxCircus.FancyBlazor

<div @attributes="RootAttributes"><AuroraBackground Palette="Palette" Intensity="Intensity" Disabled="Disabled"><NoiseOverlay Opacity=".05" Disabled="Disabled">@ChildContent</NoiseOverlay></AuroraBackground></div>

@code {
    [Parameter] public FancyPalette Palette { get; set; } = FancyPalettes.Witchlight;
    [Parameter] public double Intensity { get; set; } = .55;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private IReadOnlyDictionary<string, object> RootAttributes => AttributeComposer.Compose("syntax-circus-fancy-aurora-hero", CssClass, null, Style, AdditionalAttributes, new Dictionary<string, object> { ["data-fancy-preset"] = "aurora-hero", ["data-fancy-disabled"] = Disabled ? "true" : "false" });
}
