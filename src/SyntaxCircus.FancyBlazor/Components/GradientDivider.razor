@namespace SyntaxCircus.FancyBlazor

<div @attributes="RootAttributes" aria-hidden="true"></div>

@code {
    [Parameter] public string StartColor { get; set; } = "transparent";
    [Parameter] public string Color { get; set; } = "currentColor";
    [Parameter] public string EndColor { get; set; } = "transparent";
    [Parameter] public double Thickness { get; set; } = 1;
    [Parameter] public double Opacity { get; set; } = .65;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private IReadOnlyDictionary<string, object> RootAttributes => AttributeComposer.Compose("syntax-circus-fancy-gradient-divider", CssClass,
        $"--sc-fancy-divider-start:{StartColor};--sc-fancy-divider-color:{Color};--sc-fancy-divider-end:{EndColor};--sc-fancy-divider-thickness:{AttributeComposer.Number(AttributeComposer.Clamp(Thickness, 1, 8))}px;--sc-fancy-divider-opacity:{AttributeComposer.Number(AttributeComposer.Clamp(Opacity, 0, 1))}", Style, AdditionalAttributes,
        new Dictionary<string, object> { ["data-fancy-effect"] = "gradient-divider", ["data-fancy-disabled"] = Disabled ? "true" : "false" });
}
