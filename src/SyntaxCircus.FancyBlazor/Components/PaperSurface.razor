@namespace SyntaxCircus.FancyBlazor

<div @attributes="RootAttributes"><div class="syntax-circus-fancy-paper-surface__content">@ChildContent</div><span class="syntax-circus-fancy-paper-surface__texture" aria-hidden="true"></span></div>

@code {
    [Parameter] public string Tint { get; set; } = "#fffaf0";
    [Parameter] public string Ink { get; set; } = "currentColor";
    [Parameter] public double TextureOpacity { get; set; } = .08;
    [Parameter] public double BorderOpacity { get; set; } = .18;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private IReadOnlyDictionary<string, object> RootAttributes => AttributeComposer.Compose("syntax-circus-fancy-paper-surface", CssClass,
        $"--sc-fancy-paper-tint:{Tint};--sc-fancy-paper-ink:{Ink};--sc-fancy-paper-texture-opacity:{AttributeComposer.Number(AttributeComposer.Clamp(TextureOpacity, 0, .35))};--sc-fancy-paper-border-opacity:{AttributeComposer.Number(AttributeComposer.Clamp(BorderOpacity, 0, 1))}", Style, AdditionalAttributes,
        new Dictionary<string, object> { ["data-fancy-effect"] = "paper-surface", ["data-fancy-disabled"] = Disabled ? "true" : "false" });
}
