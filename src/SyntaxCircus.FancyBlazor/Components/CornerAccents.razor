@namespace SyntaxCircus.FancyBlazor

<div @attributes="RootAttributes"><div class="syntax-circus-fancy-corner-accents__content">@ChildContent</div><span class="syntax-circus-fancy-corner-accents__corner syntax-circus-fancy-corner-accents__corner--start" aria-hidden="true"></span><span class="syntax-circus-fancy-corner-accents__corner syntax-circus-fancy-corner-accents__corner--end" aria-hidden="true"></span></div>

@code {
    [Parameter] public string Color { get; set; } = "currentColor";
    [Parameter] public double Length { get; set; } = 24;
    [Parameter] public double Thickness { get; set; } = 1;
    [Parameter] public double Opacity { get; set; } = .7;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private IReadOnlyDictionary<string, object> RootAttributes => AttributeComposer.Compose("syntax-circus-fancy-corner-accents", CssClass,
        $"--sc-fancy-corner-color:{Color};--sc-fancy-corner-length:{AttributeComposer.Number(AttributeComposer.Clamp(Length, 8, 96))}px;--sc-fancy-corner-thickness:{AttributeComposer.Number(AttributeComposer.Clamp(Thickness, 1, 8))}px;--sc-fancy-corner-opacity:{AttributeComposer.Number(AttributeComposer.Clamp(Opacity, 0, 1))}", Style, AdditionalAttributes,
        new Dictionary<string, object> { ["data-fancy-effect"] = "corner-accents", ["data-fancy-disabled"] = Disabled ? "true" : "false" });
}
