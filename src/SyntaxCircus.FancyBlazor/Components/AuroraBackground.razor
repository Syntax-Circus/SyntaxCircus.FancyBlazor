@namespace SyntaxCircus.FancyBlazor

<div @attributes="RootAttributes"><div class="syntax-circus-fancy-aurora-background__content">@ChildContent</div><span class="syntax-circus-fancy-aurora-background__layer" aria-hidden="true"></span></div>

@code {
    [Parameter] public FancyPalette Palette { get; set; } = FancyPalettes.Witchlight;
    [Parameter] public double Intensity { get; set; } = .55;
    [Parameter] public bool Animated { get; set; } = true;
    [Parameter] public TimeSpan Duration { get; set; } = TimeSpan.FromSeconds(18);
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private IReadOnlyDictionary<string, object> RootAttributes => AttributeComposer.Compose(
        "syntax-circus-fancy-aurora-background", CssClass,
        $"--sc-fancy-primary:{Palette.Primary};--sc-fancy-secondary:{Palette.Secondary};--sc-fancy-accent:{Palette.Accent};--sc-fancy-background:{Palette.Background};--sc-fancy-aurora-intensity:{AttributeComposer.Number(AttributeComposer.Clamp(Intensity, 0, 1))};--sc-fancy-duration:{AttributeComposer.Number(AttributeComposer.NonNegative(Duration).TotalMilliseconds)}ms",
        Style, AdditionalAttributes,
        new Dictionary<string, object> { ["data-fancy-effect"] = "aurora-background", ["data-fancy-animated"] = Animated && !Disabled ? "true" : "false", ["data-fancy-disabled"] = Disabled ? "true" : "false" });
}
