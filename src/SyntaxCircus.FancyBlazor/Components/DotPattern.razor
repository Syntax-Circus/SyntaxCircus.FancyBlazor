@namespace SyntaxCircus.FancyBlazor

<div @attributes="RootAttributes"><div class="syntax-circus-fancy-dot-pattern__content">@ChildContent</div><span class="syntax-circus-fancy-dot-pattern__layer" aria-hidden="true"></span></div>

@code {
    [Parameter] public string Color { get; set; } = "currentColor";
    [Parameter] public double Spacing { get; set; } = 20;
    [Parameter] public double DotSize { get; set; } = 1;
    [Parameter] public double Opacity { get; set; } = .15;
    [Parameter] public bool Faded { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private IReadOnlyDictionary<string, object> RootAttributes => AttributeComposer.Compose("syntax-circus-fancy-dot-pattern", CssClass,
        $"--sc-fancy-dot-color:{Color};--sc-fancy-dot-spacing:{AttributeComposer.Number(AttributeComposer.Clamp(Spacing, 8, 96))}px;--sc-fancy-dot-size:{AttributeComposer.Number(AttributeComposer.Clamp(DotSize, 1, 8))}px;--sc-fancy-dot-opacity:{AttributeComposer.Number(AttributeComposer.Clamp(Opacity, 0, 1))}", Style, AdditionalAttributes,
        new Dictionary<string, object> { ["data-fancy-effect"] = "dot-pattern", ["data-fancy-faded"] = Faded ? "true" : "false", ["data-fancy-disabled"] = Disabled ? "true" : "false" });
}
