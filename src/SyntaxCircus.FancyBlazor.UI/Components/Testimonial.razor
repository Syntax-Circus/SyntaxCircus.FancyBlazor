@namespace SyntaxCircus.FancyBlazor

<figure @attributes="RootAttributes">
    <blockquote class="syntax-circus-fancy-ui-testimonial__quote">@ChildContent</blockquote>
    @if (Attribution is not null)
    {
        <figcaption class="syntax-circus-fancy-ui-testimonial__attribution">
            @if (Avatar is not null)
            {
                <div class="syntax-circus-fancy-ui-testimonial__avatar">@Avatar</div>
            }
            @Attribution
        </figcaption>
    }
</figure>

@code {
    [Inject] private IOptions<FancyUiOptions> UiOptions { get; set; } = default!;

    /// <summary>Gets or sets the quoted testimonial text.</summary>
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets the optional attribution content. Wrap the person's name in <c>&lt;cite&gt;</c> if it names the source.</summary>
    [Parameter] public RenderFragment? Attribution { get; set; }

    /// <summary>Gets or sets the optional avatar or logo content shown alongside the attribution.</summary>
    [Parameter] public RenderFragment? Avatar { get; set; }

    /// <summary>Gets or sets the theme tokens. Falls back to the configured <see cref="FancyUiOptions.Theme"/>.</summary>
    [Parameter] public FancyUiTheme? Theme { get; set; }

    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private FancyUiTheme EffectiveTheme => Theme ?? UiOptions.Value.Theme;

    private IReadOnlyDictionary<string, object> RootAttributes => UiAttributeComposer.Compose(
        "syntax-circus-fancy-ui-testimonial",
        CssClass,
        $"--sc-fancy-ui-surface:{EffectiveTheme.Surface};--sc-fancy-ui-text:{EffectiveTheme.Text};--sc-fancy-ui-border:{EffectiveTheme.Border};--sc-fancy-ui-accent:{EffectiveTheme.Accent};--sc-fancy-ui-radius:{EffectiveTheme.Radius};--sc-fancy-ui-spacing:{EffectiveTheme.Spacing}",
        Style,
        AdditionalAttributes);
}
