@namespace SyntaxCircus.FancyBlazor

<ul aria-label="@AriaLabel" @attributes="RootAttributes">
    @ChildContent
</ul>

@code {
    [Inject] private IOptions<FancyUiOptions> UiOptions { get; set; } = default!;

    /// <summary>Gets or sets the logo list items. Consumers supply their own <c>&lt;li&gt;</c> content.</summary>
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets the optional accessible label describing the list of logos.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Gets or sets the layout density.</summary>
    [Parameter] public LogoCloudLayout Layout { get; set; } = LogoCloudLayout.Wrap;

    /// <summary>Gets or sets the theme tokens. Falls back to the configured <see cref="FancyUiOptions.Theme"/>.</summary>
    [Parameter] public FancyUiTheme? Theme { get; set; }

    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private FancyUiTheme EffectiveTheme => Theme ?? UiOptions.Value.Theme;

    private string StableClass => Layout == LogoCloudLayout.Dense
        ? "syntax-circus-fancy-ui-logo-cloud syntax-circus-fancy-ui-logo-cloud--dense"
        : "syntax-circus-fancy-ui-logo-cloud";

    private IReadOnlyDictionary<string, object> RootAttributes => UiAttributeComposer.Compose(
        StableClass,
        CssClass,
        $"--sc-fancy-ui-text:{EffectiveTheme.Text};--sc-fancy-ui-spacing:{EffectiveTheme.Spacing}",
        Style,
        AdditionalAttributes);
}
