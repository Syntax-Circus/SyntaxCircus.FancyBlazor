@namespace SyntaxCircus.FancyBlazor

<div @attributes="RootAttributes">
    @if (Background is not null)
    {
        <div class="syntax-circus-fancy-ui-hero__background" aria-hidden="true">@Background</div>
    }
    <div class="syntax-circus-fancy-ui-hero__content">
        @if (Heading is not null)
        {
            <div class="syntax-circus-fancy-ui-hero__heading">@Heading</div>
        }
        @if (Subheading is not null)
        {
            <div class="syntax-circus-fancy-ui-hero__subheading">@Subheading</div>
        }
        @if (Actions is not null)
        {
            <div class="syntax-circus-fancy-ui-hero__actions">@Actions</div>
        }
    </div>
</div>

@code {
    [Inject] private IOptions<FancyUiOptions> UiOptions { get; set; } = default!;

    /// <summary>Gets or sets the heading content. Consumers choose the heading level.</summary>
    [Parameter] public RenderFragment? Heading { get; set; }

    /// <summary>Gets or sets the optional supporting subheading copy.</summary>
    [Parameter] public RenderFragment? Subheading { get; set; }

    /// <summary>Gets or sets the action content, typically one or more <see cref="FancyButton"/>/<see cref="FancyLink"/>.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Gets or sets an optional decorative background layer, for example a core visual effect. Rendered
    /// <c>aria-hidden</c> and pointer-transparent; never required.</summary>
    [Parameter] public RenderFragment? Background { get; set; }

    /// <summary>Gets or sets the content alignment.</summary>
    [Parameter] public HeroAlignment Alignment { get; set; } = HeroAlignment.Start;

    /// <summary>Gets or sets the theme tokens. Falls back to the configured <see cref="FancyUiOptions.Theme"/>.</summary>
    [Parameter] public FancyUiTheme? Theme { get; set; }

    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private FancyUiTheme EffectiveTheme => Theme ?? UiOptions.Value.Theme;

    private string StableClass => Alignment == HeroAlignment.Center
        ? "syntax-circus-fancy-ui-hero syntax-circus-fancy-ui-hero--center"
        : "syntax-circus-fancy-ui-hero";

    private IReadOnlyDictionary<string, object> RootAttributes => UiAttributeComposer.Compose(
        StableClass,
        CssClass,
        $"--sc-fancy-ui-text:{EffectiveTheme.Text};--sc-fancy-ui-accent:{EffectiveTheme.Accent};--sc-fancy-ui-spacing:{EffectiveTheme.Spacing}",
        Style,
        AdditionalAttributes);
}
