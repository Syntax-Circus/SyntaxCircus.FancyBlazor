@namespace SyntaxCircus.FancyBlazor

<div @attributes="RootAttributes">
    @if (Heading is not null)
    {
        <div class="syntax-circus-fancy-ui-cta__heading">@Heading</div>
    }
    @if (ChildContent is not null)
    {
        <div class="syntax-circus-fancy-ui-cta__body">@ChildContent</div>
    }
    @if (Actions is not null)
    {
        <div class="syntax-circus-fancy-ui-cta__actions">@Actions</div>
    }
</div>

@code {
    [Inject] private IOptions<FancyUiOptions> UiOptions { get; set; } = default!;

    /// <summary>Gets or sets the heading content. Consumers choose the heading level.</summary>
    [Parameter] public RenderFragment? Heading { get; set; }

    /// <summary>Gets or sets the optional supporting copy.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets the action content, typically one or more <see cref="FancyButton"/>/<see cref="FancyLink"/>.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Gets or sets the layout.</summary>
    [Parameter] public CallToActionLayout Layout { get; set; } = CallToActionLayout.Inline;

    /// <summary>Gets or sets the theme tokens. Falls back to the configured <see cref="FancyUiOptions.Theme"/>.</summary>
    [Parameter] public FancyUiTheme? Theme { get; set; }

    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private FancyUiTheme EffectiveTheme => Theme ?? UiOptions.Value.Theme;

    private string StableClass => Layout == CallToActionLayout.Stacked
        ? "syntax-circus-fancy-ui-cta syntax-circus-fancy-ui-cta--stacked"
        : "syntax-circus-fancy-ui-cta";

    private IReadOnlyDictionary<string, object> RootAttributes => UiAttributeComposer.Compose(
        StableClass,
        CssClass,
        $"--sc-fancy-ui-surface:{EffectiveTheme.Surface};--sc-fancy-ui-text:{EffectiveTheme.Text};--sc-fancy-ui-border:{EffectiveTheme.Border};--sc-fancy-ui-accent:{EffectiveTheme.Accent};--sc-fancy-ui-radius:{EffectiveTheme.Radius};--sc-fancy-ui-spacing:{EffectiveTheme.Spacing}",
        Style,
        AdditionalAttributes);
}
