@namespace SyntaxCircus.FancyBlazor

<article @attributes="RootAttributes">
    @if (Header is not null)
    {
        <div class="syntax-circus-fancy-ui-card__header">@Header</div>
    }
    <div class="syntax-circus-fancy-ui-card__body">@ChildContent</div>
    @if (Footer is not null)
    {
        <div class="syntax-circus-fancy-ui-card__footer">@Footer</div>
    }
</article>

@code {
    [Inject] private IOptions<FancyUiOptions> UiOptions { get; set; } = default!;

    /// <summary>Gets or sets the optional card header content.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets the optional card footer content.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Gets or sets the theme tokens. Falls back to the configured <see cref="FancyUiOptions.Theme"/>.</summary>
    [Parameter] public FancyUiTheme? Theme { get; set; }

    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private FancyUiTheme EffectiveTheme => Theme ?? UiOptions.Value.Theme;

    private IReadOnlyDictionary<string, object> RootAttributes => UiAttributeComposer.Compose(
        "syntax-circus-fancy-ui-card",
        CssClass,
        $"--sc-fancy-ui-surface:{EffectiveTheme.Surface};--sc-fancy-ui-text:{EffectiveTheme.Text};--sc-fancy-ui-border:{EffectiveTheme.Border};--sc-fancy-ui-radius:{EffectiveTheme.Radius};--sc-fancy-ui-spacing:{EffectiveTheme.Spacing}",
        Style,
        AdditionalAttributes);
}
