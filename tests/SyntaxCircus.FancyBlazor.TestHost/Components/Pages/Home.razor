@page "/"

<PageTitle>FancyBlazor browser test host</PageTitle>

<main>
    <ShaderBackground data-testid="shader-background">
        <Reveal Effect="RevealEffect.BlurUp">
            <h1>Make the ordinary interface catch light.</h1>
        </Reveal>
        <Reveal Delay="@TimeSpan.FromMilliseconds(120)">
            <p>Semantic content remains available while visual effects enhance it.</p>
        </Reveal>
        <Tilt data-testid="home-tilt" Glare="true">
            <a class="primary-action" href="/border">Inspect the effects</a>
        </Tilt>
        <p><a href="/kinetic-text">Kinetic text showcase</a></p>
        <p><a href="/atmospheric-backgrounds">Atmospheric backgrounds showcase</a></p>
        <p><a href="/interaction-scroll">Interaction and scroll showcase</a></p>
    </ShaderBackground>
</main>
